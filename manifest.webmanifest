{
  "name": "Le gros front",
  "short_name": "Gros front",
  "description": "Phone on your forehead: tilt down when you guess, tilt up to pass.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
